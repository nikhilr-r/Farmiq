# =============================================================
#  AgriQ V2 — Root .gitignore
#  Covers: Node.js, React/Vite, Python/ML, OS & IDE files
# =============================================================


# ─────────────────────────────────────────────
#  NODE.JS (server/ & client/)
# ─────────────────────────────────────────────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
.pnp
.pnp.js


# ─────────────────────────────────────────────
#  ENVIRONMENT & SECRETS  ← most important
# ─────────────────────────────────────────────

.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production
.env.production.local

# Never commit secrets or API keys
*.pem
*.key
*.cert


# ─────────────────────────────────────────────
#  REACT / VITE (client/)
# ─────────────────────────────────────────────

client/dist/
client/.vite/
client/build/


# ─────────────────────────────────────────────
#  PYTHON / ML (model/)
# ─────────────────────────────────────────────

# Virtual environment
model/.venv/
model/venv/
model/env/
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Trained model checkpoints (large binary files — too big for GitHub)
model/exports/*.pth
model/exports/*.pt
model/exports/*.onnx
model/exports/*.mlpackage
model/exports/*.mlmodel

# Dataset — never commit raw images to git
model/data/
model/dataset/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# ML experiment tracking
wandb/
mlruns/
.mlflow/
lightning_logs/

# Evaluation output images (regeneratable)
# Comment these out if you WANT to keep them in the repo
# model/evaluation_results/*.png

# Temporary files
model/tmp_help.txt
model/album_out.txt
*.tmp


# ─────────────────────────────────────────────
#  LOGS
# ─────────────────────────────────────────────

logs/
*.log
server/logs/


# ─────────────────────────────────────────────
#  OS GENERATED FILES
# ─────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ─────────────────────────────────────────────
#  IDE & EDITOR FILES
# ─────────────────────────────────────────────

# VS Code (keep settings but ignore local overrides)
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains (PyCharm, WebStorm)
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo

# Sublime Text
*.sublime-project
*.sublime-workspace


# ─────────────────────────────────────────────
#  MISC PROJECT FILES
# ─────────────────────────────────────────────

# Scratch files created during development
scratch.js
walkthrough_5
tree.txt

# Local database
server/data/db/

